# NightShift environment configuration
# Copy to .env and fill in secrets before starting the daemon.

# ── Discord control plane ────────────────────────────────────────────
# Bot token (from Discord Developer Portal → Bot).
DISCORD_BOT_TOKEN=
# Server (guild) id — required to register slash commands (Sales Decision OS).
DISCORD_GUILD_ID=
# Default text channel for the bot (slash commands, logging, etc.).
# Also used as the fallback channel for proactive decision cards if
# DISCORD_DECISION_CHANNEL_ID is unset.
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=
# Optional: post rich embeds via webhook instead of / in addition to the bot.
DISCORD_WEBHOOK_URL=

# ── Phase 8 — proactive decision moments (one active card, edit-in-place) ─
# Set to 1/true to enable the monitor loop on bot ready (posts/edits a single card).
DECISION_MOMENTS_ENABLED=1
# Optional: dedicated channel for the decision card (e.g. #sales). If empty, uses DISCORD_CHANNEL_ID.
# DISCORD_DECISION_CHANNEL_ID=
# How often to re-evaluate top moment and refresh the card (ms). Default 300000 (5 min).
DECISION_MONITOR_INTERVAL_MS=300000
# Gates: only surface when model confidence and priority_index pass (see docs/sales-decision-engine.md).
DECISION_MIN_CONFIDENCE=0.6
# Minimum priority_index 0–100 for the moment (stricter than Phase 3 global DECISION_MIN_PRIORITY_INDEX).
DECISION_MOMENT_MIN_PRIORITY=65
# Card “expires in …” window (hours).
DECISION_EXPIRY_HOURS=8
# If 1, pre-run Pair Debate in the background so Run Debate can feel instant (uses LLM quota).
# DECISION_PRECOMPUTE_DEBATE=0
# Stop resurfacing the same deal after this many Skip presses (default 3).
# DECISION_MOMENT_MAX_IGNORE=3
# Note: At most one proactive card is ever active; there is no DECISION_MAX_ACTIVE env (fixed in code).
# Live rollout checklist: docs/discord-sales-os-smoke-checklist.md

# ── Project under construction ───────────────────────────────────────
PROJECT_DIR=/home/hedgeguard
PROJECT_MAIN_BRANCH=main
BRANCH_PREFIX=nightshift

# ── Brain repo (OpenClaw knowledge layer) ────────────────────────────
BRAIN_DIR=/home/openclaw-brain
BRAIN_AUTO_PUSH=true

# ── Engines ──────────────────────────────────────────────────────────
# Paths to CLI binaries. Leave empty to use $PATH lookup.
CLAUDE_BIN=claude
CODEX_BIN=codex
OLLAMA_BIN=ollama

# Default models
CLAUDE_MODEL=claude-opus-4-6
CODEX_MODEL=gpt-5.4
LOCAL_MODEL=codellama:34b

# ── Safety / guardrails ──────────────────────────────────────────────
MAX_RUNTIME_HOURS=8
MAX_COST_USD=20
MAX_RETRIES_PER_TASK=3
MAX_CONSECUTIVE_ESCALATIONS=5
AUTO_ACCEPT_MAX_LINES=500
BRANCH_MAX_AGE_DAYS=7
# Comma-separated npm/pip packages pre-approved for install.
# Unknown packages get queued for Discord approval.
PACKAGE_WHITELIST=zod,axios,dotenv,dayjs,lodash,uuid,discord.js,commander

# ── Session pool / parallelism ───────────────────────────────────────
POOL_MAX_CONCURRENT=3
POOL_MAX_CLAUDE=2
POOL_MAX_CODEX=2
POOL_MAX_LOCAL=1
POOL_SESSION_TIMEOUT_MS=900000
POOL_STALL_MS=120000
POOL_WORKTREE_ROOT=/tmp/ns-worktrees
POOL_ENABLE_PARALLEL=true

# ── Context window management ────────────────────────────────────────
CONTEXT_COMPACT_AT_PCT=80
CONTEXT_KILL_AT_PCT=90
CLAUDE_CONTEXT_LIMIT=200000

# ── Coordinator loop ─────────────────────────────────────────────────
COORDINATOR_TICK_MS=10000

# ── Test & lint commands (auto-detected if left blank) ───────────────
TEST_COMMAND=
LINT_COMMAND=

# ── Runtime ──────────────────────────────────────────────────────────
LOG_LEVEL=info
STATE_DIR=./state

# ── Sales / Pair Debate — world + Phase 3 decision engine ────────────
# SALES_WORLD_JSON=./state/sales-world.json
# PAIR_DEBATE_OUTCOMES_PATH=./state/pair-debate-outcomes.jsonl
# DECISION_TRIGGER_MIN_DEAL_USD=25000
# DECISION_TRIGGER_STALL_DAYS=7
# DECISION_MIN_PRIORITY_INDEX=35
# DECISION_DEBATE_MIN_TRIGGERS=1

# ── Sales / Phase 4 — SalesAction policy + audit ─────────────────────
# SALES_EXEC_AUDIT_PATH=./state/sales-actions.jsonl
# SALES_EXEC_AUTO_SEND_ENABLED=0
# SALES_EXEC_REQUIRE_DOMAIN_ALLOWLIST=0
# SALES_EXEC_ALLOWED_EMAIL_DOMAINS=yourcompany.com,partner.com
# SALES_EXEC_BANNED_PHRASES=guaranteed ROI,wire transfer today
# SALES_EXEC_APPROVAL_MIN_DEAL_USD=100000

# ── Sales / Phase 5 — strategy profile (learning) ───────────────────
# SALES_STRATEGY_PROFILE_PATH=./state/sales-strategy-profile.json
# SALES_COMPANY_ID=my-company
