{
  "name": "wire2-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "synthetics": "tsx src/synthetics/runSynthetics.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/db/seed.ts",
    "guard:tenancy": "tsx src/scripts/checkTenantScoping.ts",
    "guard:migrations": "tsx src/scripts/checkMigrationSafety.ts",
    "validate:tenant-constraints": "tsx src/scripts/validateTenantConstraints.ts",
    "test": "vitest run",
    "openapi:validate": "tsx src/openapi/validate-spec.ts",
    "openapi:generate-types": "tsx src/openapi/generate-types.ts",
    "openapi:serve": "npx @redocly/cli preview-docs src/openapi/wire.openapi.json",
    "openapi:mock-server": "tsx src/openapi/mock-server.ts",
    "openapi:contract-tests": "vitest run src/openapi/contract-tests.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/multipart": "^9.0.3",
    "@prisma/client": "^6.19.1",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.1",
    "form-data": "^4.0.1",
    "ioredis": "^5.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/form-data": "^2.5.0",
    "@types/node": "^20.17.12",
    "prisma": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
