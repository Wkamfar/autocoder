{
  "info": {
    "name": "WIRE API",
    "description": "Postman collection for WIRE API - intents, approvals, voice challenges, audit bundles, API keys, and webhooks.\n\nAuth:\n- Recommended: Basic auth using API_KEY + API_SECRET variables\n- UI sessions: set BEARER_TOKEN and switch auth as needed",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "wire-api-v1"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{API_KEY}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{API_SECRET}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/wire",
      "type": "string"
    },
    {
      "key": "API_KEY",
      "value": "wire_live_your_api_key",
      "type": "string"
    },
    {
      "key": "API_SECRET",
      "value": "wkey_secret_your_secret",
      "type": "string"
    },
    {
      "key": "BEARER_TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "X_USER_ID",
      "value": "user_123",
      "type": "string"
    },
    {
      "key": "intent_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "beneficiary_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "challenge_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "proof_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "approval_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "api_key_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "webhook_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Get Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Get service health status"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Intents",
      "item": [
        {
          "name": "List Intents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-USER-ID",
                "value": "{{X_USER_ID}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/intents",
              "host": ["{{base_url}}"],
              "path": ["intents"]
            },
            "description": "List all transfer intents for the authenticated user's organization"
          },
          "response": []
        },
        {
          "name": "Get Intent",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-USER-ID",
                "value": "{{X_USER_ID}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/intents/{{intent_id}}",
              "host": ["{{base_url}}"],
              "path": ["intents", "{{intent_id}}"]
            },
            "description": "Get a specific transfer intent by ID"
          },
          "response": []
        },
        {
          "name": "Create Intent",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('intent_id', response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-USER-ID",
                "value": "{{X_USER_ID}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"railsType\": \"ACH\",\n  \"amountMinor\": \"50000\",\n  \"currency\": \"USD\",\n  \"beneficiaryId\": \"{{beneficiary_id}}\",\n  \"purpose\": \"Payment for services rendered\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/intents",
              "host": ["{{base_url}}"],
              "path": ["intents"]
            },
            "description": "Create a new transfer intent"
          },
          "response": []
        },
        {
          "name": "Update Intent",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-USER-ID",
                "value": "{{X_USER_ID}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"Updated payment purpose\",\n  \"amountMinor\": \"75000\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/intents/{{intent_id}}",
              "host": ["{{base_url}}"],
              "path": ["intents", "{{intent_id}}"]
            },
            "description": "Update a transfer intent"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Challenges",
      "item": [
        {
          "name": "Create Challenge",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('challenge_id', response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-USER-ID",
                "value": "{{X_USER_ID}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"language\": \"EN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/intents/{{intent_id}}/challenge",
              "host": ["{{base_url}}"],
              "path": ["intents", "{{intent_id}}", "challenge"]
            },
            "description": "Create a voice challenge for a transfer intent"
          },
          "response": []
        },
        {
          "name": "Submit Proof",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('proof_id', response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-USER-ID",
                "value": "{{X_USER_ID}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"BROWSER\",\n  \"transcript\": \"Authorize transfer 50000 minor units to beneficiary ending 1234. Nonce 'abc12-def34-ghij56'.\",\n  \"transcriptLanguage\": \"EN\",\n  \"deviceMetadataJson\": {\n    \"ip\": \"192.168.1.1\",\n    \"userAgent\": \"Mozilla/5.0\",\n    \"browser\": \"Chrome\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/challenges/{{challenge_id}}/proof",
              "host": ["{{base_url}}"],
              "path": ["challenges", "{{challenge_id}}", "proof"]
            },
            "description": "Submit a voice proof for a challenge"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Decisions",
      "item": [
        {
          "name": "Create Decision",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.approvalToken) {",
                  "        pm.collectionVariables.set('approval_token', response.approvalToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-USER-ID",
                "value": "{{X_USER_ID}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"APPROVE\",\n  \"proofId\": \"{{proof_id}}\",\n  \"reasonCodesJson\": [\"low_risk\", \"domestic_transfer\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/intents/{{intent_id}}/decision",
              "host": ["{{base_url}}"],
              "path": ["intents", "{{intent_id}}", "decision"]
            },
            "description": "Create an approval decision for a transfer intent"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Execution",
      "item": [
        {
          "name": "Execute Intent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-USER-ID",
                "value": "{{X_USER_ID}}"
              },
              {
                "key": "X-POSE-APPROVAL",
                "value": "{{approval_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/intents/{{intent_id}}/execute",
              "host": ["{{base_url}}"],
              "path": ["intents", "{{intent_id}}", "execute"]
            },
            "description": "Execute a transfer intent using an approval token"
          },
          "response": []
        }
      ]
    },
