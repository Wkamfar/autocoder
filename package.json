{
  "name": "nightshift",
  "version": "0.1.0",
  "description": "OpenClaw Autonomous Build System — a 24/7 agent that drives Claude Code, Codex, and local models through Discord to execute and self-plan coding objectives.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nightshift": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "daemon": "tsx src/index.ts daemon",
    "cli": "tsx src/index.ts cli",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
