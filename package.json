{
  "name": "nightshift",
  "version": "0.1.0",
  "description": "OpenClaw Autonomous Build System — a 24/7 agent that drives Claude Code, Codex, and local models through Discord to execute and self-plan coding objectives.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nightshift": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "daemon": "tsx src/index.ts daemon",
    "cli": "tsx src/index.ts cli",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "clean": "rm -rf dist",
    "rollout:seed-world": "bash scripts/seed-sales-world.sh",
    "rollout:check": "node scripts/check-rollout-env.mjs",
    "ci:smoke": "npm run build && bash scripts/smoke-ci.sh",
    "ci": "npm run typecheck && npm test && npm run build && bash scripts/smoke-ci.sh",
    "dataset:marketry": "node scripts/publish-marketry-dataset.mjs",
    "validate:marketry-csv": "node scripts/validate-marketry-csv.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "discord.js": "^14.16.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
