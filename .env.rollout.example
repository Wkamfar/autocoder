# ── Sales OS rollout template (team-tested shape; copy to .env and replace secrets) ──
# Do not commit a filled .env. Keep secrets in your vault / CI secrets.
#
# Quick start:
#   cp .env.rollout.example .env
#   npm run rollout:seed-world
#   # Edit .env: DISCORD_BOT_TOKEN, DISCORD_GUILD_ID, DISCORD_CHANNEL_ID
#   npm run build && npm run daemon
#
# Full guide: docs/sales-os-rollout.md

# Required for Discord bot
DISCORD_BOT_TOKEN=REPLACE_ME
# Required for slash commands (Sales Decision OS) — copy Server ID (Developer Mode)
DISCORD_GUILD_ID=REPLACE_ME
# Channel the bot can read/post (right-click channel → Copy ID)
DISCORD_CHANNEL_ID=REPLACE_ME
DISCORD_OWNER_ID=

# Optional: v7 CRM `!ns sales` — restrict channel / owner (see src/config.ts)
# DISCORD_SALES_CHANNEL_ID=
# DISCORD_SALES_REQUIRE_OWNER=1

# Sales world (default path matches seed script)
STATE_DIR=./state
# SALES_WORLD_JSON=./state/sales-world.json

# Phase 8 proactive card — off until you want it (avoids surprise posts)
DECISION_MOMENTS_ENABLED=0
# DECISION_MONITOR_INTERVAL_MS=300000
# DECISION_MIN_CONFIDENCE=0.6
# DECISION_MOMENT_MIN_PRIORITY=65
# DECISION_EXPIRY_HOURS=8
# DISCORD_DECISION_CHANNEL_ID=

# Pair Debate — engines on PATH; set API keys per engine (e.g. Anthropic for Claude)
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-opus-4-6

LOG_LEVEL=info
